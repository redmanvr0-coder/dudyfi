--[[
    Roblox Delta VR Script - Full Body VR Mode
    Detects if player is in VR and enables Nexus-style arm/hand movement
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local VRService = game:GetService("VRService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- VR Detection
local function isPlayerInVR()
    return VRService.VREnabled and UserInputService.VREnabled
end

-- Create VR Arms & Hands
local function setupVRArms()
    -- Check if already setup
    if character:FindFirstChild("VRSetup") then return end
    
    local vrSetup = Instance.new("Folder")
    vrSetup.Name = "VRSetup"
    vrSetup.Parent = character
    
    -- Left Arm
    local leftArm = Instance.new("Part")
    leftArm.Name = "LeftArm"
    leftArm.Size = Vector3.new(0.4, 1.2, 0.4)
    leftArm.Shape = Enum.PartType.Block
    leftArm.Material = Enum.Material.SmoothPlastic
    leftArm.Color = BrickColor.new("Bright blue")
    leftArm.Anchored = false
    leftArm.CanCollide = false
    leftArm.Parent = vrSetup
    
    local leftArmWeld = Instance.new("Weld")
    leftArmWeld.Part0 = rootPart
    leftArmWeld.Part1 = leftArm
    leftArmWeld.C0 = CFrame.new(-1.5, 0.5, 0)
    leftArmWeld.Parent = leftArm
    
    -- Left Hand
    local leftHand = Instance.new("Part")
    leftHand.Name = "LeftHand"
    leftHand.Size = Vector3.new(0.3, 0.3, 0.3)
    leftHand.Shape = Enum.PartType.Block
    leftHand.Material = Enum.Material.SmoothPlastic
    leftHand.Color = BrickColor.new("Bright yellow")
    leftHand.Anchored = false
    leftHand.CanCollide = false
    leftHand.Parent = vrSetup
    
    local leftHandWeld = Instance.new("Weld")
    leftHandWeld.Part0 = leftArm
    leftHandWeld.Part1 = leftHand
    leftHandWeld.C0 = CFrame.new(0, -0.8, 0)
    leftHandWeld.Parent = leftHand
    
    -- Right Arm
    local rightArm = Instance.new("Part")
    rightArm.Name = "RightArm"
    rightArm.Size = Vector3.new(0.4, 1.2, 0.4)
    rightArm.Shape = Enum.PartType.Block
    rightArm.Material = Enum.Material.SmoothPlastic
    rightArm.Color = BrickColor.new("Bright red")
    rightArm.Anchored = false
    rightArm.CanCollide = false
    rightArm.Parent = vrSetup
    
    local rightArmWeld = Instance.new("Weld")
    rightArmWeld.Part0 = rootPart
    rightArmWeld.Part1 = rightArm
    rightArmWeld.C0 = CFrame.new(1.5, 0.5, 0)
    rightArmWeld.Parent = rightArm
    
    -- Right Hand
    local rightHand = Instance.new("Part")
    rightHand.Name = "RightHand"
    rightHand.Size = Vector3.new(0.3, 0.3, 0.3)
    rightHand.Shape = Enum.PartType.Block
    rightHand.Material = Enum.Material.SmoothPlastic
    rightHand.Color = BrickColor.new("Bright green")
    rightHand.Anchored = false
    rightHand.CanCollide = false
    rightHand.Parent = vrSetup
    
    local rightHandWeld = Instance.new("Weld")
    rightHandWeld.Part0 = rightArm
    rightHandWeld.Part1 = rightHand
    rightHandWeld.C0 = CFrame.new(0, -0.8, 0)
    rightHandWeld.Parent = rightHand
    
    -- VR Movement Variables
    local vrData = {
        LeftArm = leftArm,
        LeftHand = leftHand,
        RightArm = rightArm,
        RightHand = rightHand,
        LeftArmWeld = leftArmWeld,
        RightArmWeld = rightArmWeld,
        LeftHandWeld = leftHandWeld,
        RightHandWeld = rightHandWeld
    }
    
    return vrData
end

-- Nexus VR Style Movement
local function updateVRMovement(vrParts, deltaTime)
    if not vrParts then return end
    
    local head = character:FindFirstChild("Head")
    if not head then return end
    
    -- Get Head CFrame for orientation
    local headCFrame = head.CFrame
    
    -- Left Arm Movement (mirrors head rotation)
    local leftArmOffset = CFrame.new(-1.2, -0.5, 0.3) * 
                         CFrame.Angles(
                             math.sin(os.time() * 2) * 0.1,
                             math.cos(os.time() * 1.5) * 0.1,
                             math.sin(os.time() * 1.8) * 0.1
                         )
    
    vrParts.LeftArmWeld.C0 = leftArmOffset
    vrParts.LeftArmWeld.Part0 = rootPart
    
    -- Left Hand Movement (independent wrist movement)
    local leftHandOffset = CFrame.new(0, -0.8, 0.1) * 
                           CFrame.Angles(
                               math.sin(os.time() * 3) * 0.2,
                               math.cos(os.time() * 2.5) * 0.15,
                               math.sin(os.time() * 2.2) * 0.15
                           )
    
    vrParts.LeftHandWeld.C0 = leftHandOffset
    vrParts.LeftHandWeld.Part0 = vrParts.LeftArm
    
    -- Right Arm Movement
    local rightArmOffset = CFrame.new(1.2, -0.5, 0.3) * 
                           CFrame.Angles(
                               math.sin(os.time() * 2 + 1) * 0.1,
                               math.cos(os.time() * 1.5 + 1) * 0.1,
                               math.sin(os.time() * 1.8 + 1) * 0.1
                           )
    
    vrParts.RightArmWeld.C0 = rightArmOffset
    vrParts.RightArmWeld.Part0 = rootPart
    
    -- Right Hand Movement
    local rightHandOffset = CFrame.new(0, -0.8, 0.1) * 
                            CFrame.Angles(
                                math.sin(os.time() * 3 + 1) * 0.2,
                                math.cos(os.time() * 2.5 + 1) * 0.15,
                                math.sin(os.time() * 2.2 + 1) * 0.15
                            )
    
    vrParts.RightHandWeld.C0 = rightHandOffset
    vrParts.RightHandWeld.Part0 = vrParts.RightArm
end

-- Main VR Handler
local function handleVR()
    if not isPlayerInVR() then
        -- Remove VR setup if not in VR
        local vrSetup = character:FindFirstChild("VRSetup")
        if vrSetup then
            vrSetup:Destroy()
        end
        return
    end
    
    -- Setup VR parts if not already
    if not character:FindFirstChild("VRSetup") then
        local vrParts = setupVRArms()
        if vrParts then
            -- Store for update loop
            character.VRSetup.VRParts = vrParts
        end
    end
    
    -- Get VR parts and update
    local vrSetup = character:FindFirstChild("VRSetup")
    if vrSetup and vrSetup:FindFirstChild("VRParts") then
        local vrParts = vrSetup.VRParts
        updateVRMovement(vrParts, RunService.Heartbeat:Wait())
    end
end

-- Character Added Event
player.CharacterAdded:Connect(function(newChar)
    character = newChar
    rootPart = character:WaitForChild("HumanoidRootPart")
    humanoid = character:WaitForChild("Humanoid")
    
    -- Re-setup VR
    wait(0.5)
    handleVR()
end)

-- Main Loop
local function mainLoop()
    while task.wait(0.05) do
        if character and rootPart and humanoid then
            handleVR()
        end
    end
end

-- Start the script
task.spawn(mainLoop)

-- Print status
print("Delta VR Script Loaded!")
print("VR Mode: " .. tostring(isPlayerInVR()))
